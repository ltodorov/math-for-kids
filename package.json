{
  "name": "math-for-kids",
  "version": "2.2.0",
  "description": "A web page where kids can practice Math - addition, subtraction, multiplication and division.",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "webpack serve --config webpack.dev.js",
    "build": "pnpm typecheck && webpack --config webpack.prod.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src/scripts/",
    "all": "pnpm lint && pnpm test --coverage && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltodorov/math-for-kids.git"
  },
  "author": "Lyubomir Todorov",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/ltodorov/math-for-kids/issues"
  },
  "homepage": "https://github.com/ltodorov/math-for-kids#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "handlebars": "^4.7.10",
    "handlebars-loader": "^1.7.3",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.33",
    "postcss-preset-env": "^11.6.2",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  }
}
