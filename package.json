{
  "name": "math-for-kids",
  "version": "2.2.0",
  "description": "A web page where kids can practice Math - addition, subtraction, multiplication and division.",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "webpack serve --config webpack.dev.js",
    "build": "pnpm typecheck && webpack --config webpack.prod.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src/scripts/",
    "all": "pnpm lint && pnpm test --coverage && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltodorov/math-for-kids.git"
  },
  "author": "Lyubomir Todorov",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/ltodorov/math-for-kids/issues"
  },
  "homepage": "https://github.com/ltodorov/math-for-kids#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "copy-webpack-plugin": "^14.0.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "handlebars": "^4.7.9",
    "handlebars-loader": "^1.7.3",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.1",
    "sass": "^1.104.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
